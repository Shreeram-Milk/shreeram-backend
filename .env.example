# Copy to .env.local and fill in. .env.local is ignored by Git. Never commit real values.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Origins allowed to call the API from a browser (the admin). Comma-separated, no wildcard.
# The mobile app sends no Origin header and is not affected by this.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3001

# Application database user (read/write on data only). Use the tunnel's local address.
DATABASE_URL=postgres://shreeram_app:CHANGE_ME@localhost:5432/shreeram_dev

# Migration user (can create and alter tables). Used only by `npm run migrate`.
MIGRATION_DATABASE_URL=postgres://shreeram_migrate:CHANGE_ME@localhost:5432/shreeram_dev

# TLS to RDS. Keep certificate checks on.
#   DB_SSL_CA_PATH       path to the AWS RDS CA bundle (global-bundle.pem)
#   DB_TLS_SERVERNAME    the RDS hostname, because you connect through a tunnel on localhost
# For a local Postgres with no TLS in development only, set DB_SSL=disable instead.
DB_SSL=require
DB_SSL_CA_PATH=
DB_TLS_SERVERNAME=
RATE_LIMIT_PER_MINUTE=300

# Signs login codes and sessions: 32+ random characters. Generate your own; never reuse or commit it.
AUTH_SECRET=
# How admin login codes are delivered.
#   console = print them in the backend window (development only; refused in production)
#   smtp    = email them through the SMTP settings below (Gmail, or AWS SES's SMTP endpoint)
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# File storage (private S3 bucket). Set both region and bucket, or neither.
AWS_REGION=
S3_MEDIA_BUCKET=
# Development only: access keys for the shreeram-local-dev IAM user. Never commit them and never use them in production
# (production uses an IAM role, so leave these unset there).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# PhonePe online payments. Leave the client id, secret and merchant id empty in development to use the built-in test
# payment (no money moves; refused in production). Values come from the PhonePe Business Dashboard, Developer Settings.
# Never put live values in chat or in Git.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=
# Typed into PhonePe's webhook settings (production / AWS only; PhonePe cannot reach localhost).
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
